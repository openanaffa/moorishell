{
	"name": "site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint \"src/**/*.{ts,svelte}\" *.ts *.js",
		"format:check": "prettier --plugin prettier-plugin-svelte --check \"src/**/*.{ts,svelte,css}\" *.ts *.js",
		"format": "prettier --plugin prettier-plugin-svelte --write \"src/**/*.{ts,svelte,css}\" *.ts *.js",
		"check:all": "bun run check && bun run lint && bun run format:check && bun run build"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-vercel": "^7.0.4",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"eslint": "^10.15.0",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"rehype-pretty-code": "^0.14.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vite": "^8.3.8"
	},
	"dependencies": {
		"gsap": "^3.15.1"
	}
}
