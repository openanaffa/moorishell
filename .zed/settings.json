{
  "format_on_save": "on",
  "ensure_final_newline_on_save": true,
  "remove_trailing_whitespace_on_save": true,
  "tab_size": 4,
  "soft_wrap": "editor_width",
  "languages": {
    "PowerShell": {
      "tab_size": 4,
      "format_on_save": "off"
    },
    "JSON": {
      "tab_size": 2
    },
    "JSONC": {
      "tab_size": 2
    },
    "YAML": {
      "tab_size": 2
    },
    "Markdown": {
      "tab_size": 2,
      "soft_wrap": "editor_width"
    }
  },
  "file_scan_exclusions": [
    "**/target",
    "**/node_modules",
    "**/.venv*",
    "**/venv",
    "**/__pycache__",
    "**/.git"
  ]
}
